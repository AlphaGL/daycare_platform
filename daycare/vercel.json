{
  "version": 2,
  "builds": [
    {
      "src": "daycare/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "daycare/wsgi.py"
    }
  ],
  "env": {
    "DEBUG": "False"
  }
}